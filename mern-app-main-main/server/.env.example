PORT=5050
JWT_SECRET=change-this-to-a-strong-random-secret
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Origens permitidas no CORS, separadas por vírgula (ex.: http://localhost:3000,https://meu-projeto.onrender.com)
# Requisições da própria origem (same-origin) e sem header Origin são sempre permitidas.
CORS_ORIGIN=http://localhost:3000,https://tcc-phyto.onrender.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
FRONTEND_URL=http://localhost:3000

# ===== E-mail (verificação de conta) =====
# Sem SMTP configurado, o cadastro cria a conta já ativada (sem confirmação).
# Dica: para Gmail, use "App Password" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-do-gmail
SMTP_FROM=Phytografia <seu-email@gmail.com>
