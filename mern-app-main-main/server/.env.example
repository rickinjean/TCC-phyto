PORT=5050
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_REFRESH_SECRET=change-this-to-another-strong-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Origens permitidas no CORS, separadas por vírgula (ex.: http://localhost:3000,https://meu-projeto.onrender.com)
# Requisições da própria origem (same-origin) e sem header Origin são sempre permitidas.
CORS_ORIGIN=http://localhost:3000,https://tcc-phyto.onrender.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
FRONTEND_URL=http://localhost:3000

# ===== E-mail (verificação de conta via Resend) =====
# Sem Resend configurado, o cadastro cria a conta já ativada (sem confirmação).
# Crie uma conta em https://resend.com, verifique seu domínio e gere uma API Key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM=Phytografia <seu-dominio.com>
